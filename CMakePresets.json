{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly production build",
      "inherits": "wasm-debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    }
  ],
  "testPresets": [
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
